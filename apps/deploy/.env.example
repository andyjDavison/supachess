# Copy to .env on the VM. Never commit the real one.

# Apex domain. Frontend is served at https://$DOMAIN (Vercel),
# API at https://api.$DOMAIN (this VM).
DOMAIN=example.com

POSTGRES_USER=supachess
POSTGRES_DB=supachess
# Goes into DATABASE_URL, so keep it URL-safe: openssl rand -hex 32
# Only read when the postgres volume is first created - changing it later
# needs ALTER USER inside the database too.
POSTGRES_PASSWORD=

# openssl rand -hex 48  (changing it later logs everyone out)
JWT_SECRET=

# Image tag to run: "latest" or a commit SHA from CI (for rollbacks).
API_TAG=latest
